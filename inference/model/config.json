{
  "seed": 1337,
  "paths": {
    "data_root": "data/raw/BTXRD",
    "images_dirname": "images",
    "annotations_dirname": "Annotations",
    "table_name": "dataset.xlsx",
    "table_sheet": 0,
    "splits_file": "data/interim/splits.json",
    "cache_dir": "data/cache",
    "reports_dir": "reports"
  },
  "labels": {
    "classes": [
      "normal",
      "benign",
      "malignant"
    ],
    "id_column": "image_id",
    "tumor_column": "tumor",
    "class_columns": [
      {
        "column": "malignant",
        "class": "malignant"
      },
      {
        "column": "benign",
        "class": "benign"
      }
    ],
    "subtype_columns": {
      "benign": [
        "osteochondroma",
        "multiple osteochondromas",
        "simple bone cyst",
        "giant cell tumor",
        "osteofibroma",
        "synovial osteochondroma",
        "other bt"
      ],
      "malignant": [
        "osteosarcoma",
        "other mt"
      ]
    }
  },
  "columns": {
    "anatomy": [
      "hand",
      "ulna",
      "radius",
      "humerus",
      "foot",
      "tibia",
      "fibula",
      "femur",
      "hip bone",
      "ankle-joint",
      "knee-joint",
      "hip-joint",
      "wrist-joint",
      "elbow-joint",
      "shoulder-joint",
      "upper limb",
      "lower limb",
      "pelvis"
    ],
    "view": [
      "frontal",
      "lateral",
      "oblique"
    ],
    "demographic": [
      "center",
      "age",
      "gender"
    ]
  },
  "split": {
    "train": 0.7,
    "val": 0.15,
    "test": 0.15,
    "group_strategy": "surrogate_patient",
    "require_consecutive_ids": true,
    "stratify": true
  },
  "data": {
    "image_size": 256,
    "in_channels": 3,
    "intensity_percentiles": [
      1.0,
      99.0
    ],
    "norm_mean": [
      0.485,
      0.456,
      0.406
    ],
    "norm_std": [
      0.229,
      0.224,
      0.225
    ],
    "crop_foreground": false,
    "crop_threshold": 0.05,
    "crop_margin": 8
  },
  "augment": {
    "hflip_prob": 0.5,
    "rotate_prob": 0.5,
    "rotate_degrees": 15.0,
    "zoom_prob": 0.3,
    "zoom_range": [
      0.9,
      1.1
    ],
    "contrast_prob": 0.5,
    "gamma_range": [
      0.5,
      2.0
    ],
    "noise_prob": 0.3,
    "noise_std": 0.01
  },
  "loader": {
    "batch_size": 32,
    "num_workers": 0,
    "cache_rate": 1.0,
    "pin_memory": true,
    "persistent_workers": false,
    "drop_last_train": true,
    "balanced_sampler": false,
    "samples_per_epoch": null
  },
  "model": {
    "name": "densenet121",
    "pretrained": true,
    "num_classes": 3,
    "dropout": 0.2
  },
  "loss": {
    "name": "focal",
    "gamma": 2.0,
    "auto_alpha": true,
    "label_smoothing": 0.0,
    "alpha_beta": 1.0,
    "alpha": null
  },
  "calibrate": {
    "temperature": true,
    "mode": "specificity_floor",
    "target_sensitivity": 0.95,
    "min_specificity": 0.8,
    "max_temperature": 10.0
  },
  "train": {
    "epochs": 40,
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "optimizer": "adamw",
    "scheduler": "cosine",
    "warmup_epochs": 2,
    "amp": true,
    "amp_dtype": "bfloat16",
    "miopen": false,
    "grad_clip": 1.0,
    "early_stopping_metric": "roc_auc_macro",
    "early_stopping_patience": 7
  },
  "eval": {
    "bootstrap_n": 2000,
    "bootstrap_alpha": 0.05,
    "target_sensitivity": 0.9
  },
  "explain": {
    "method": "gradcam",
    "target_layer": "features.denseblock4",
    "cam_threshold": 0.5
  }
}