# --- Data (never commit: BTXRD is CC BY-NC-ND 4.0, ~840 MB) -----------------
data/
!data/.gitkeep

# --- Run outputs ------------------------------------------------------------
reports/
runs/
outputs/
*.pt
*.pth
*.ckpt
*.onnx

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Secrets ----------------------------------------------------------------
# .env holds API keys and backend credentials. None of the patterns above match
# it: `env/` is a directory pattern and `.venv/` is a different name entirely,
# so before this block .env was fully committable. Keep these lines.
.env
.env.*
# Streamlit secrets hold the Google OAuth client secret and the session
# cookie secret. The repo is public and Streamlit creates this path by
# convention, so an untracked-by-luck file is not good enough.
.streamlit/secrets.toml
!.env.example

# D1 database dumps. `wrangler d1 export` is the sensible thing to run before a
# migration, and it writes into this directory by default -- so the safe habit
# and the dangerous file are produced by the same command. A dump carries every
# user's email, their PBKDF2 hash, and every shared radiograph as base64: it is
# the single most sensitive artefact this project can generate, and it lands one
# `git add -A` away from a public repository.
#
# Ignored by extension rather than by exact name, because the next backup will
# be called something else and whoever writes it will not check this file first.
cloudflare/*.sql
!cloudflare/schema.sql
cloudflare/migrations/*.sql
!cloudflare/migrations/[0-9][0-9][0-9][0-9]_*.sql
# wrangler's local state: a local D1 replica, build output and caches.
cloudflare/.wrangler/

# --- Tooling ----------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/

# --- IDE / OS ---------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini

# --- uv (tests are run via uv in some environments) ---------------------------
uv.lock

# Generated Cloudflare keys (cloudflare/deploy.sh writes this)
.cloudflare-keys.txt

# Globe assets are fetched once at runtime from a pinned CDN, not vendored
src/components/assets/
