# --- Data (never commit: BTXRD is CC BY-NC-ND 4.0, ~840 MB) -----------------
data/
!data/.gitkeep

# --- Run outputs ------------------------------------------------------------
reports/
runs/
outputs/
*.pt
*.pth
*.ckpt
*.onnx

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Secrets ----------------------------------------------------------------
# .env holds API keys and backend credentials. None of the patterns above match
# it: `env/` is a directory pattern and `.venv/` is a different name entirely,
# so before this block .env was fully committable. Keep these lines.
.env
.env.*
# Streamlit secrets hold the Google OAuth client secret and the session
# cookie secret. The repo is public and Streamlit creates this path by
# convention, so an untracked-by-luck file is not good enough.
.streamlit/secrets.toml
!.env.example

# D1 database dumps. `wrangler d1 export` is the sensible thing to run before a
# migration, and it writes into this directory by default -- so the safe habit
# and the dangerous file are produced by the same command. A dump carries every
# user's email, their PBKDF2 hash, and every shared radiograph as base64: it is
# the single most sensitive artefact this project can generate, and it lands one
# `git add -A` away from a public repository.
#
# Ignored by extension rather than by exact name, because the next backup will
# be called something else and whoever writes it will not check this file first.
cloudflare/*.sql
!cloudflare/schema.sql
cloudflare/migrations/*.sql
!cloudflare/migrations/[0-9][0-9][0-9][0-9]_*.sql
# wrangler's local state: a local D1 replica, build output and caches.
cloudflare/.wrangler/

# Community training manifests.
#
# These are derived files, rebuilt from data/community/ by
# scripts/sync_community.py, so nothing is lost by not tracking them. They are
# ignored because of what a row *is*: one line per radiograph a real person
# uploaded and consented to share, carrying its content hash and the class a
# reviewer assigned it. The images themselves are under data/, already ignored;
# publishing an index of them to a public repository would undo that a column at
# a time, and it would do so in a file nobody thinks of as patient data because
# it is only a CSV of paths.
#
# Only three things are meant to meet a shared radiograph: the person who
# uploaded it, the owner reviewing it, and the model being trained. A commit is
# none of those.
#
# paths.controls_manifest in configs/base.yaml points here, and build_records()
# treats the file as optional -- a checkout without it trains on BTXRD alone,
# which is exactly the right behaviour for anyone who is not running this
# deployment.
configs/controls_manifest.csv
configs/ood_manifest.csv

