/yasmine/

# --- uv (tests are run via uv in some environments) ---------------------------
uv.lock

# Generated Cloudflare keys (cloudflare/deploy.sh writes this)
.cloudflare-keys.txt

# Pinned globe assets are vendored so the homepage can draw country geometry
# without relying on browser or Streamlit-server network access.

# Personal Claude Code permission rules. These pre-approve wrangler commands
# that write to the production D1 database and Worker, so they belong to one
# machine and one operator rather than to everyone who clones a public repo.
.claude/settings.local.json

# Container build context: staged model weights (27 MB, must never be public).
# Populated by scripts/stage_inference_model.py from reports/PRODUCTION.
inference/model/

# Node dependencies for the Worker and the Vite frontend.
node_modules/

# wrangler's local state at the repository root (the Worker that serves the
# site). cloudflare/.wrangler/ above covers the older onnm-community Worker.
.wrangler/
