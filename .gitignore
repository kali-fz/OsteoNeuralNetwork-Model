# --- Data (never commit: BTXRD is CC BY-NC-ND 4.0, ~840 MB) -----------------
data/
!data/.gitkeep

# --- Run outputs ------------------------------------------------------------
reports/
runs/
outputs/
*.pt
*.pth
*.ckpt
*.onnx

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Secrets ----------------------------------------------------------------
# .env holds API keys and backend credentials. None of the patterns above match
# it: `env/` is a directory pattern and `.venv/` is a different name entirely,
# so before this block .env was fully committable. Keep these lines.
.env
.env.*
# Streamlit secrets hold the Google OAuth client secret and the session
# cookie secret. The repo is public and Streamlit creates this path by
# convention, so an untracked-by-luck file is not good enough.
.streamlit/secrets.toml
!.env.example

# --- Tooling ----------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/

# --- IDE / OS ---------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini

# --- uv (tests are run via uv in some environments) ---------------------------
uv.lock

# Generated Cloudflare keys (cloudflare/deploy.sh writes this)
.cloudflare-keys.txt
