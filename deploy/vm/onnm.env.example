# ONNM service environment. Installed to /etc/onnm.env, root-owned, mode 0600.
#
# NEVER commit the filled-in version. This example carries placeholders only.
# The real file lives outside the repository precisely so that a `git add -A`
# cannot sweep it up.

# --- Public hostname -------------------------------------------------------
# Streamlit builds absolute URLs from this. Wrong value = broken links and a
# WebSocket that tries to connect to the wrong origin.
STREAMLIT_BROWSER_SERVER_ADDRESS=REPLACE_WITH_YOUR_DOMAIN

# --- Cloudflare Worker + D1 ------------------------------------------------
# Setting BOTH of these is what switches src/backend.py from local SQLite to
# hosted D1. Setting only one silently leaves the app on SQLite, which on a
# fresh VM means an empty user table and every existing account appearing not
# to exist. Set both or neither.
ONNM_COMMUNITY_URL=https://onnm-community.kali-fz.workers.dev
ONNM_COMMUNITY_KEY=REPLACE_WITH_WORKER_API_KEY

# Admin key for the /admin/* endpoints. The review console (review_app.py) is
# local-only and never deployed, but app.py uses this to gate the admin UI.
ONNM_ADMIN_KEY=REPLACE_WITH_ADMIN_KEY

# --- Model checkpoint ------------------------------------------------------
# Fetched SERVER-SIDE at boot by src/checkpoint_fetch.py onto this machine's
# persistent disk. The weights never reach a browser.
#
# Because the disk persists, this download happens once rather than on every
# restart -- unlike Streamlit Cloud, where each container rebuild re-fetched
# 28 MB before the first scan could run.
ONNM_CHECKPOINT_URL=REPLACE_WITH_CHECKPOINT_URL

# Optional but worth setting. The magic-bytes check in checkpoint_fetch.py
# catches a WRONG file (a CDN 404 returns HTTP 200 with an HTML body, which
# would otherwise land in best.pt and fail much later inside torch.load).
# Only a digest catches a TRUNCATED right one.
# Value for v1.0.0 is recorded in model_versions.json.
ONNM_CHECKPOINT_SHA256=REPLACE_WITH_SHA256

# Cosmetic: names the directory under reports/. Deliberately not "production",
# which would collide with the reports/PRODUCTION marker on case-insensitive
# filesystems.
ONNM_CHECKPOINT_RUN=hosted
